{
  // 天道改规 Agent 参数（REMAKE-IMPL-E0-S5）。默认值 = 用户裁决表（2026-10-23）。
  // 校准重拟合只改本文件、不动代码（工程侧 §7.2 回填块 / 设计侧 §6.1）。
  // 读取方：Core/Agent/AgentConfigLoader.cs（Newtonsoft 解析，容许 // 注释）。
  // 位置约定：Assets/StreamingAssets/Agent/——刻意不在 StreamingAssets/Configs/ 下：
  //   tools/sync-configs.sh 会 rm -rf Configs/ 后从 legacy-web 重同步，放那里会被抹除。

  // ── 业力曲线（合同 = 设计侧 §1.4 六档锚点表，用户裁决 #2 确认）──
  "karma_curve": {
    // [token, karma] 锚点：E:1@2.5K / D:16@8K / B:32@12K / A:48@15K / C:55@16K / C+:91@21K
    "anchors": [[2500, 1], [8000, 16], [12000, 32], [15000, 48], [16000, 55], [21000, 91]],
    "floor_token": 2500,            // T < 此值为平地价区（f=1）
    "extend_last_slope": true,      // T > 21K 以末段斜率 0.0072/token 延伸（触顶 120≈25K）
    "min": 1,                       // 业力下限（成功即有价）
    "max": 120                      // 基准单次上限（技能 +40/次由 karma_single_max_bonus 另行抬高）
  },

  // ── 混合制波动（设计侧 §1.6；裁决 #2/D-6 当前值）──
  "fluctuation": {
    "uniform": [0.8, 1.3],          // σ ~ U(0.8, 1.3)，每次提交抽一次
    "surge": {
      "token_threshold": 20000,     // T_eff ≥ 20K 才可能激增
      "probability": 0.30,          // p = 0.30
      "range": [1.25, 1.5]          // 触发时 surge ~ U(1.25, 1.5)
    }
  },

  // 零写入路径业力硬上限·保险丝（设计 D-1）：恒 1 规则下默认不触发，
  // 仅防未来「长对话按 token 计费」变体爆米。
  "chat_cap": 5,

  // ── 作用域深度权重（REMAKE-IMPL-E3C 校准补丁；实测 167 次反推）──
  // 公式：clamp(round(f(T_eff) × σ × surge × discount × scopeWeight) + flat, 1, singleMax)
  // scopeWeight = 本次提交所有成功写入触及作用域中的**最大**权重（乘在 discount 之后、flat 之前）。
  // 作用域是补丁的机械属性（target + op + JSON Pointer），不是意图分类：
  //   ui_config  ← target ui_config / board（尺寸·几何，D 档同价）
  //   board_state← move_piece 落子/生死；board_state 的 /pieces/*、/game_status/*
  //   rules      ← target rules；board_state 的 /mechanisms/**；pieces_* 改既有棋子走法（改规）
  //   pieces     ← pieces_* 里 add 到 /pieces/<新棋子键>（铸子）
  //   objectives ← set_objective
  // 零写入恒 1（不吃权重）；未识别作用域按 1.0；同次提交取 max 不叠加。
  "scope_weights": {
    "ui_config": 1.0,               // D 微调：14×1.0 ≈ 14（旧价中位 15）
    "board_state": 2.9,             // B 移子：13.8×2.9 ≈ 40（旧价中位 38）
    "pieces": 1.85,                 // C+ 铸子：51×1.85 ≈ 94（旧价中位 97）
    "rules": 3.35,                  // A 机制 / C 改规：14.6×3.35 ≈ 49（旧价 45/53）
    "objectives": 3.35              // 关卡目标覆写：与改规同深度
  },

  // ── 循环与预算限额（工程侧 §13.1 由 20s 反推的生产值）──
  "limits": {
    "max_rounds": 4,                // 4 轮 × 3.5s + 首轮 5.5s + 收尾 3s ≈ 19s ≤ 20s
    "repeat_tool_cap": 3,           // 同一工具连续重复调用上限
    "max_tool_errors": 3,           // 工具错误回喂自愈上限（§5.3）
    "token_hard_stop": 60000,       // API 成本保险丝（延迟预算先于它绑定）
    "context_soft_cap": 24000,      // 上下文软顶（4 轮 × 回执压缩后 ~5-8K 的防御值）
    "hard_timeout_s": 20            // 裁决 #4：20s 是玩家体验底线，不得上调
  },

  // ── 生产速度配置（裁决 #4 联动；校准前提——先定型性能配置再校准）──
  "performance": {
    "effort_profile": "M2",         // 工具轮 reasoning_effort=low + 终轮 high
    "prefix_cache": "maximize",     // system+schema 字节级稳定（§13.2 R1-R7）
    "timeout_action": "A",          // 20s 到点：有写入→partial 预览；无写入→失败卡（§13.6）
    "per_round_max_tokens": {
      "tool": 2048,                 // 工具轮 max_tokens
      "final": 4096                 // 终轮 max_tokens
    }
  },

  // ── 道级业力平坦加数（设计侧 D-7：畜生道「改高等级棋子 +20」，f×roll 之后加）──
  "realm_karma_flat": {
    "animal": { "high_rank_piece": 20 }
  }
}
